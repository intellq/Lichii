# Hash shader translation inputs without depending on a command-line list length limit.
file(STRINGS "${FILE_LIST}" files)
set(combined "")
foreach (file IN LISTS files)
    file(READ "${SOURCE_DIR}/${file}" content)
    string(REPLACE "\r" "" content "${content}")
    string(SHA256 hash "${content}")
    string(APPEND combined "${file} ${hash}\n")
endforeach()
string(SHA256 stamp "${combined}")
string(SUBSTRING "${stamp}" 0 16 stamp)
file(WRITE "${OUTPUT}.tmp" "// Generated by CMakeModules/GeneratePrecompiledShaderStamp.cmake
#pragma once
#include \"common/common_types.h\"
namespace VideoCommon::ShaderCacheV2 {
inline constexpr u64 PrecompiledShaderStamp = 0x${stamp}ULL;
} // namespace VideoCommon::ShaderCacheV2
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
